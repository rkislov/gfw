# Set the actual LAN interface, e.g. br-lan or enp2s0. Never use the WAN here.
GFW_LAN_INTERFACE=br-lan
# Must match gfwd's actual HTTPS listen port (or its trusted local TLS proxy).
GFW_MANAGEMENT_PORT=8443
# Total PCAP storage in MiB. Use a dedicated volume for long rotations.
# GFW_CAPTURE_QUOTA_MIB=512
